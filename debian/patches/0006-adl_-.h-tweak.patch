From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Mon, 17 Aug 2026 19:18:12 +0100
Subject: adl_*.h tweak

ADL's headers spell the memory allocation callback __stdcall unconditionally.
It used to be defined away for non-Windows inside adl_sdk.h itself; the ADL
SDK 18 headers no longer do that, so do it in adl-edid.h
---
 src/libcec/platform/adl/adl-edid.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/libcec/platform/adl/adl-edid.h b/src/libcec/platform/adl/adl-edid.h
index b0c7dc4..64ae3c5 100644
--- a/src/libcec/platform/adl/adl-edid.h
+++ b/src/libcec/platform/adl/adl-edid.h
@@ -38,6 +38,13 @@
 #include "platform/util/edid.h"
 
 #if !defined(__WINDOWS__)
+// ADL's headers spell the memory allocation callback __stdcall unconditionally.
+// It used to be defined away for non-Windows inside adl_sdk.h itself; the ADL
+// SDK 18 headers no longer do that, so do it here and leave them pristine.
+#if !defined(__stdcall)
+#define __stdcall
+#endif
+
 #include "adl_sdk.h"
 #include <dlfcn.h>
 #include <stdlib.h>	
